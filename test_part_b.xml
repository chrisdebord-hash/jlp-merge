<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 3.1 Partwise//EN"
  "http://www.musicxml.org/dtds/partwise.dtd">
<score-partwise version="3.1">
  <part-list>
    <score-part id="P1">
      <part-name>Violin</part-name>
    </score-part>
    <score-part id="P2">
      <part-name>Bass</part-name>
    </score-part>
  </part-list>

  <!-- Violin — measures re-start at 1 (as PlayScore exports them) -->
  <part id="P1">
    <measure number="1">
      <note>
        <pitch><step>B</step><octave>4</octave></pitch>
        <duration>4</duration><type>whole</type>
      </note>
    </measure>
    <measure number="2">
      <note>
        <pitch><step>C</step><octave>5</octave></pitch>
        <duration>4</duration><type>whole</type>
      </note>
    </measure>
  </part>

  <!-- Bass — measure with unknown number to trigger warning -->
  <part id="P2">
    <measure number="1">
      <note>
        <pitch><step>D</step><octave>2</octave></pitch>
        <duration>4</duration><type>whole</type>
      </note>
    </measure>
    <measure number="?">
      <note>
        <!-- Unknown-duration measure warning should appear -->
        <pitch><step>E</step><octave>2</octave></pitch>
        <duration>4</duration><type>whole</type>
      </note>
    </measure>
  </part>
</score-partwise>
